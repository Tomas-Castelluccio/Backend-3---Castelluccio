{
  "openapi": "3.0.3",
  "info": {
    "title": "Users API",
    "version": "1.0.0",
    "description": "Endpoints de gestión de usuarios. Requieren un JWT obtenido desde la API de sesiones."
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Servidor local" }
  ],
  "tags": [
    { "name": "Users", "description": "Gestión de usuarios" }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Listar usuarios",
        "description": "Requiere autenticación y rol admin. La respuesta nunca incluye contraseñas.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Usuarios encontrados",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Crear un usuario",
        "description": "Requiere autenticación y rol admin. El servicio crea un carrito para el usuario.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserInput" } } }
        },
        "responses": {
          "201": {
            "description": "Usuario creado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/users/{uid}": {
      "parameters": [
        {
          "name": "uid",
          "in": "path",
          "required": true,
          "description": "ObjectId del usuario",
          "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }
        }
      ],
      "get": {
        "tags": ["Users"],
        "summary": "Obtener un usuario",
        "description": "El usuario autenticado puede consultar su propio perfil; admin puede consultar cualquiera.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Actualizar un usuario",
        "description": "Requiere autenticación y rol admin. Permite enviar uno o más campos modificables.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateUserInput" } } }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Eliminar un usuario",
        "description": "Requiere autenticación y rol admin. También intenta eliminar el carrito asociado.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Usuario eliminado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "message": { "type": "string", "example": "Usuario eliminado" }
                  },
                  "required": ["id", "message"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "664f3c8a8d1d1a0f9c7a5b1a" },
          "first_name": { "type": "string", "example": "Ana" },
          "last_name": { "type": "string", "example": "García" },
          "email": { "type": "string", "format": "email", "example": "ana@example.com" },
          "age": { "type": "integer", "minimum": 0, "example": 28 },
          "cart": { "type": "string", "nullable": true },
          "role": { "type": "string", "enum": ["user", "admin"] },
          "pets": { "type": "array", "items": {}, "default": [] }
        },
        "required": ["id", "first_name", "last_name", "email", "age", "role"]
      },
      "CreateUserInput": {
        "type": "object",
        "properties": {
          "first_name": { "type": "string", "example": "Ana" },
          "last_name": { "type": "string", "example": "García" },
          "email": { "type": "string", "format": "email", "example": "ana@example.com" },
          "age": { "type": "integer", "minimum": 0, "example": 28 },
          "password": { "type": "string", "minLength": 6, "writeOnly": true, "example": "claveSegura123" },
          "role": { "type": "string", "enum": ["user", "admin"], "default": "user" }
        },
        "required": ["first_name", "last_name", "email", "age", "password"]
      },
      "UpdateUserInput": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "age": { "type": "integer", "minimum": 0 },
          "password": { "type": "string", "minLength": 6, "writeOnly": true },
          "role": { "type": "string", "enum": ["user", "admin"] }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Acceso denegado" }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Token ausente, inválido o expirado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "El rol o propietario no tiene permiso para esta operación",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Usuario no encontrado",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ServerError": {
        "description": "Error de validación, persistencia u otro error interno",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
