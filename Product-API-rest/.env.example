# Copiar como .env para desarrollo local.
NODE_ENV=development
PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# Reemplazar por un secreto privado de al menos 16 caracteres.
JWT_SECRET=local-development-secret-change-me-32chars
JWT_EXPIRES_IN=24h

LOG_LEVEL=debug
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000

# En el desarrollo, el enlace de recuperación se escribe en la consola.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@ecommerce.com
FRONTEND_URL=http://localhost:8080
RESET_TOKEN_EXPIRES_MINUTES=60
